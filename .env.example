# Copy to .env (git-ignored) and fill in. Never commit real values.
HF_TOKEN=                      # read-only Hugging Face token (private TriFrame repos, gated news corpus)
NEXUS_ARTIFACTS=               # optional: artifact root (default ./artifacts; on Colab a Drive folder)
NEXUS_OHLCV_ROOT=              # optional: TriFrame data store (default ~/Downloads/us_stocks_ohlcv)
NEXUS_SEC_FULL500_RUN=         # optional: SEC study 500-firm CPU outputs
NEXUS_HOLDOUT_CONFIG=          # owner only, for the single sealed evaluation
NEXUS_HOLDOUT_UNLOCK=          # owner only: sha256 of NEXUS_HOLDOUT_CONFIG; never written to any file
